{ pkgs, ... }:

let
  # Sets up a Windows game (an unpacked .exe, not an installer) to run under
  # Steam's Proton with umu: asks for its name, store, umu GAMEID and Proton,
  # then writes ~/Games/umu/<slug>/launch.sh (with the prefix next to it) and
  # an app-menu entry. umu-run itself is installed system-wide.
  umuAddGame = pkgs.writeShellApplication {
    name = "umu-add-game";
    runtimeInputs = with pkgs; [ coreutils gnused icoutils curl jq desktop-file-utils ];
    text = ''
      die() { echo "umu-add-game: $*" >&2; exit 1; }

      # Prompt with an editable default; an empty answer keeps the default
      ask() {
        local reply
        read -e -r -p "$1: " -i "$2" reply || exit 1
        printf '%s' "''${reply:-$2}"
      }

      # Saves the exe's own icon (its first icon group, largest image) as $1
      extract_icon() {
        local tmp args best="" score bestscore=0 f
        tmp=$(mktemp -d) || return 1
        # First line of the listing, e.g. "--type=14 --name=101 --language=1033 [...]"
        read -ra args <<< "$(wrestool -l -t 14 "$exe" 2>/dev/null | sed -n "1{s/ \[.*//;s/'//g;p}")"
        if [ ''${#args[@]} -gt 0 ] \
          && wrestool -x "''${args[@]}" "$exe" > "$tmp/icon.ico" 2>/dev/null \
          && icotool -x -o "$tmp" "$tmp/icon.ico" 2>/dev/null; then
          # icotool names them icon_<n>_<w>x<h>x<depth>.png
          for f in "$tmp"/*.png; do
            [[ $f =~ _([0-9]+)x[0-9]+x([0-9]+)\.png$ ]] || continue
            score=$(( BASH_REMATCH[1] * 1000 + BASH_REMATCH[2] ))
            if (( score > bestscore )); then best=$f; bestscore=$score; fi
          done
        fi
        [ -n "$best" ] && cp "$best" "$1"
        local status=$?
        rm -rf "$tmp"
        return $status
      }

      [ $# -eq 1 ] || die "usage: umu-add-game <path/to/game.exe>"
      [ -f "$1" ] || die "no such file: $1"
      exe=$(realpath "$1")
      case "''${exe,,}" in
        *.exe) ;;
        *) die "not an .exe: $exe" ;;
      esac
      exedir=$(dirname "$exe")

      name=$(ask "Name" "$(basename "$exedir")")
      slug=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
      [ -n "$slug" ] || die "can't make a directory name from \"$name\""
      dir="$HOME/Games/umu/$slug"
      desktop="$HOME/.local/share/applications/umu-$slug.desktop"
      [ -e "$dir" ] && die "$dir already exists"
      [ -e "$desktop" ] && die "$desktop already exists"

      store=$(ask "Store (none, gog, egs, humble, itchio, ...)" none)

      query="title=$(printf '%s' "$name" | jq -sRr @uri)"
      if [ "$store" != none ]; then
        query+="&store=$(printf '%s' "$store" | jq -sRr @uri)"
      fi
      found=$(curl -fsS --max-time 5 "https://umu.openwinecomponents.org/umu_api.php?$query" 2>/dev/null \
        | jq -r '.[0].umu_id // empty' 2>/dev/null) || found=""
      if [ -n "$found" ]; then
        echo "Found $found in the umu database."
      else
        echo "Not in the umu database; 0 runs it with plain Proton."
      fi
      gameid=$(ask "GAMEID" "''${found:-0}")

      proton=$(ask "Proton" "$HOME/.local/share/Steam/steamapps/common/Proton - Experimental")
      [ -f "$proton/proton" ] || die "no Proton in $proton"

      mkdir -p "$dir/prefix"
      {
        echo '#!/usr/bin/env bash'
        echo '# Generated by umu-add-game'
        printf 'export WINEPREFIX=%q\n' "$dir/prefix"
        printf 'export GAMEID=%q\n' "$gameid"
        if [ "$store" != none ]; then printf 'export STORE=%q\n' "$store"; fi
        printf 'export PROTONPATH=%q\n' "$proton"
        printf 'cd %q\n' "$exedir"
        printf "exec umu-run %q \"\$@\"\n" "$exe"
      } > "$dir/launch.sh"
      chmod 755 "$dir/launch.sh"

      if extract_icon "$dir/icon.png"; then
        icon="$dir/icon.png"
      else
        echo "No icon found in the exe; using a generic one."
        icon=applications-games
      fi

      mkdir -p "$(dirname "$desktop")"
      cat > "$desktop" <<EOF
      [Desktop Entry]
      Type=Application
      Name=$name
      Exec=$dir/launch.sh
      Icon=$icon
      Categories=Game;
      Terminal=false
      EOF
      desktop-file-validate "$desktop" || echo "warning: desktop-file-validate complained about $desktop" >&2

      echo
      echo "Launch script: $dir/launch.sh"
      echo "Menu entry:    $desktop"
      echo "The first launch creates the prefix (and, the first time ever, downloads umu's runtime)."
      echo "To remove the game: rm -r $dir $desktop"
    '';
  };
in {
  home.packages = [ umuAddGame ];
}
