import QtQuick

// Flexoki Dark with its colours given narrower jobs: orange stays the
// accent, yellow only marks occupied workspaces as a faint wash, sliders
// are orange with a pale handle, and chosen entries sit on an orange row.
Scheme {
    name: "FlexokiCalm"
    background: "#100f0f"
    surface: "#343331"
    highlight: "#403e3c"
    textColor: "#cecdc3"
    dimTextColor: "#9f9d96"
    accent: "#da702c"
    occupied: "#d0a215"
    good: "#879a39"
    bad: "#d14d41"
    menuColor: "#1c1b1a"
    borderColor: "#403e3c"
    sliderFill: "#da702c"
    sliderKnob: "#cecdc3"
    workspaceStyle: "tint"
    selectionStyle: "row"
}
